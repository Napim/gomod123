{
  "type": "companion",
  "model": "lunar:cosmetics/models/gek/companions/gomod_mascot_v3/gomod_mascot.geo.json",
  "texture": "lunar:cosmetics/models/gek/companions/gomod_mascot_v3/gomodmascot.png",
  "animation": "lunar:cosmetics/models/gek/companions/gomod_mascot_v3/gomod_mascot.anim.json",
  "attributes": {
    "hitbox_height": 0.95,
    "hitbox_width": 0.55,
    "step_height": 0.45,
    "speed": "(lunar.is_or_was_state_follow_owner()&&query.owner_distance>10)?0.2:0.1",
    "yaw_speed": "temp.rot=math.abs(query.entity_y_rotation-query.entity_y_rotation_target);math.max(math.max(math.min(temp.rot,360.0-temp.rot)/20.0,10.0),4.0);",
    "max_fall": 3.0,
    "pathfinder": "GROUND",
    "has_physics": true,
    "eye_height": 0.82,
    "friction": 0.875
  },
  "default_anim": {
    "swimming": "q.is_in_water",
    "idle": "1"
  },
  "states": [
    {
      "id": "follow_owner",
      "condition": "(!lunar.is_or_was_state_playful_wander() || query.owner_distance > 1) && query.owner_distance > 1 && query.owner_distance <= 30 && c.afk_timer <= 5",
      "cooldown": 0,
      "tasks": [
        {"type": "look_at_target", "continuous": true},
        {"type": "move_to_owner", "distance": 2, "should_continue": "query.owner_distance < 30 && c.afk_timer <= 3"}
      ],
      "animation": {
        "walk": "query.owner_distance <= 10",
        "run": "query.owner_distance > 10",
        "swimming": "q.is_in_water"
      }
    },
    {
      "id": "teleport_to_owner",
      "condition": "query.owner_distance >= 30",
      "cooldown": 0,
      "tasks": [{"type": "teleport_to_owner", "radius": 5}],
      "animation": "idle"
    },
    {
      "id": "playful_wander",
      "condition": "c.afk_timer > 5",
      "cooldown": 0,
      "tasks": [
        {"type": "look_at_target", "continuous": true},
        {"type": "random_wander", "radius": 4}
      ],
      "animation": {
        "walk": "1",
        "swimming": "q.is_in_water"
      }
    }
  ]
}
